# ══════════════════════════════════════════════════════════════════════════════
# AgroNest — Variables de entorno unificadas
# Copia las secciones relevantes a Backend/.env y/o Frontend/.env según corresponda.
# NUNCA commitas archivos .env con valores reales.
# ══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# BACKEND  (Backend/.env)
# ─────────────────────────────────────────────────────────────────────────────

# API
API_BASE_URL=http://localhost:8001
API_BASE_DESCRIPTION="Entorno Local"
ENVIRONMENT_BASE_URL='{"LOCAL": "http://localhost:8001/"}'

# Swagger Basic Auth
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
SKIP_SETUP=False
SECRET_KEY=

# JWT
JWT_SECRET=                    # hex 64 chars — genera con: openssl rand -hex 32
JWT_SECRET_RENEW=              # hex 64 chars — genera con: openssl rand -hex 32
JWT_TOKEN_EXPIRATION=200       # minutos
JWT_RENEW_EXPIRATION=9         # minutos
ALGORITHM=HS256

# Logs
LOG_ROUTE=log/
LOG_LEVEL=DEBUG
LOG_FILE_SIZE=21600000
LOG_BACKUP_COUNT=30
LOG_NOMENCLATURE=log

# Base de datos (PostgreSQL)
DB_SERVER=localhost
DB_SERVER_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Redis (opcional — la API funciona sin él)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_EXP=86400

# SMTP (recuperación de contraseña)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                 # App password de Gmail, no la contraseña real
VCODE_EXP_MIN=3
ML_EXP_MIN=30

CREATE_CONFIGURATION=True

# Blockchain — Arbitrum Sepolia (Chain ID 11155111)
RPC_URL=https://sepolia.drpc.org
CHAIN_ID=11155111
API_PRIVATE_KEY=               # Clave privada de wallet de DEV — NUNCA usar en producción
CONTRACT_ABI_DIR=./contracts/abis
AGRONEST_CONTRACT_ADDRESS=     # Address del contrato AgroNest.sol desplegado
USDC_CONTRACT_ADDRESS=         # Address del contrato USDC en Sepolia

# Google Gemini AI
# Dejar vacío activa respuestas demo sin llamar a la API
# Obtener key: https://aistudio.google.com
GEMINI_API_KEY=

# Etherfuse CETES on-chain (sandbox: https://api.sand.etherfuse.com)
# Dejar vacío activa modo mock con datos demo
# Obtener key: https://dashboard.etherfuse.com
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com

# Rare Protocol / NFT Marketplace (Base Sepolia)
RARE_CONTRACT_ADDRESS=
RARE_NETWORK=base-sepolia


# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND  (Frontend/.env)
# ─────────────────────────────────────────────────────────────────────────────

# URL base del backend (sin trailing slash)
# En desarrollo con el proxy de Vite puedes dejarlo vacío
VITE_API_BASE_URL=http://localhost:8001

# Nombre de la aplicación mostrado en la UI
VITE_APP_NAME=AgroNest
